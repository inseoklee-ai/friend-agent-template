# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# Langfuse 관측. Settings > API Keys 에서 만든다. 리전 주소와 가입 리전이 같아야 한다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# 프롬프트 A/B 테스트. on 일 때만 사용자 ID 로 prod-a, prod-b 라벨을 나눠 쓴다.
# Langfuse 에 그 두 라벨이 붙어 있어야 하고, 확인이 끝나면 off 로 돌리고 라벨을 뗀다.
AB_TEST=off
